# Copy this file to .env and fill in YOUR values. Never commit .env.
# Get the database values from Supabase → your project → Connect → "Session pooler".

APP_NAME="StockWise Inventory"
APP_ENV=development
APP_TIMEZONE=Asia/Manila

DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSLMODE=require
# Optional: path to Supabase's CA certificate for full verification (then use DB_SSLMODE=verify-full)
# DB_SSLROOTCERT=C:/path/to/prod-supabase.cer
